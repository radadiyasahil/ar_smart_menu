{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/ARSmartMenu.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Dev: Backend (watch)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/backend/src/ARSmartMenu.API/ARSmartMenu.API.csproj",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "dotnet watch|Building",
          "endsPattern": "Now listening on:|Application started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devServers"
      }
    },
    {
      "label": "Dev: Admin Panel",
      "type": "npm",
      "script": "dev",
      "path": "admin-panel",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "Local:.*http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devServers"
      }
    },
    {
      "label": "Dev: Flutter Web",
      "type": "shell",
      "command": "flutter run -d chrome --web-port=8080",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "flutter",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Launching|Waiting for connection",
          "endsPattern": "Flutter run key commands|To hot restart"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devServers"
      }
    },
    {
      "label": "Dev: Start All (auto-reload)",
      "dependsOn": [
        "Dev: Backend (watch)",
        "Dev: Admin Panel",
        "Dev: Flutter Web"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/backend/src/ARSmartMenu.API/ARSmartMenu.API.csproj",
        "--launch-profile",
        "http"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
